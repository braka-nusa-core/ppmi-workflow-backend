generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UnitType {
  DIVISION
  DEPARTMENT
}

enum UserRole {
  SUPERADMIN
  USER
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  REVISION
  CANCEL
  LOGIN
  LOGOUT
  VIEW
  CLICK
  OTHER
}

enum LogReferenceType {
  QUOTATION_SLIP
  POLICY_PLACEMENT
  REQUEST_FOR_INVOICE
  INVOICE
  INCOMING_PAYMENT
  OUTGOING_PAYMENT
  SHIPMENT
  USER_MANAGEMENT
  INSURANCE_COMPANY
  SURVEYOR
  WARRANTY
  TERMS_AND_CONDITIONS
  QS_TEMPLATE
  BANK
  INSURANCE_TYPE
}

model OrganizationUnit {
  id            String   @id @default(cuid())
  parent_id     String?

  name          String
  type          UnitType

  parent        OrganizationUnit?  @relation("UnitHierarchy", fields: [parent_id], references: [id])
  children      OrganizationUnit[] @relation("UnitHierarchy")

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  deleted_at    DateTime? 

  users         User[]
  permissions   OrganizationUnitPermission[]

  @@unique([name, type])
  @@map("organization_unit")
}

model User {
  id                      String    @id @default(cuid())
  fullname                String
  email                   String    @unique
  phone                   String?   @unique
  password                String    @db.Text
  role                    UserRole  @default(USER)

  organization_unit_id    String?
  organization_unit       OrganizationUnit? @relation(fields: [organization_unit_id], references: [id])
  logs       Log[]

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  @@map("user")
}

model Permission {
  id                      String    @id @default(cuid())
  resource                String
  action                  String
  description             String?

  organizations           OrganizationUnitPermission[]

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  @@unique([resource, action])
  @@map("permission")
}

model OrganizationUnitPermission {
  organization_unit_id    String
  permission_id           String

  organization_unit       OrganizationUnit  @relation(fields: [organization_unit_id],references: [id])
  permission              Permission        @relation(fields: [permission_id],references: [id])

  @@id([organization_unit_id, permission_id])
  @@map("organization_unit_permission")
}

model Log {
  id                      String         @id @default(uuid())
  user_id                 String
  action                  LogAction
  description             String         @db.Text
  reference_id            String?
  reference_type          LogReferenceType?
  details                 String?        @db.Text

  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  user                    User @relation(fields: [user_id], references: [id])
  
  @@index([reference_type, reference_id])
  @@map("log")
}
