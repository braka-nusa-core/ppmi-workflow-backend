generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UnitType {
  DIVISION
  DEPARTMENT
}

enum UserRole {
  SUPERADMIN
  USER
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  REVISION
  CANCEL
  LOGIN
  LOGOUT
  VIEW
  CLICK
  OTHER
}

enum LogReferenceType {
  QUOTATION_SLIP
  POLICY_PLACEMENT
  REQUEST_FOR_INVOICE
  INVOICE
  INCOMING_PAYMENT
  OUTGOING_PAYMENT
  SHIPMENT
  USER_MANAGEMENT
  INSURANCE_COMPANY
  SURVEYOR
  WARRANTY
  TERMS_AND_CONDITIONS
  QS_TEMPLATE
  BANK
  INSURANCE_TYPE
}

enum QuotationStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  SENT_TO_INSURANCE
  REVISION
  INSURANCE_APPROVED
  POLICY_ISSUED
}

enum QuotationApprovalAction {
  APPROVED
  REJECTED
  REVISION
}

enum InsuranceReviewAction {
  APPROVED
  REVISION
}

enum PniClubFormat {
  INIGO_SYNDICATE_1301
  EAGLE_OCEAN_MARINE
  MSIG_SPECIALTY_MARINE_NV
}

enum PniPremiumBasis {
  PER_ANNUM
  PER_VESSEL_PER_ANNUM
  PRO_RATA
  INCLUDED_NO_ADDITIONAL_CHARGE
  OTHER
}

enum PniProvisionType {
  CONDITION
  CLAUSE
  EXCLUSION
  WARRANTY
}

enum PniProvisionSource {
  PREDEFINED
  CUSTOM
}

enum PniProvisionScope {
  QUOTE
  ALL_VESSELS
  SELECTED_VESSELS
}

enum PniDeductibleScope {
  FLAT
  CLAIM_CATEGORY
  ALL_VESSELS
  SELECTED_VESSELS
}

enum QsTemplateDomain {
  PNI
  HULL_MACHINERY
  CARGO
}

enum CargoInstituteClause {
  INSTITUTE_CARGO_A
  INSTITUTE_CARGO_B
  INSTITUTE_CARGO_C
  INSTITUTE_BULK_OIL
  INSTITUTE_COAL
  INSTITUTE_CARGO_AIR
}

enum QuotationTermSection {
  TERMS_CONDITIONS
  ADJUSTER_SURVEYOR
}

enum ParticipantRole {
  LEADER
  MEMBER
}

enum PolicyStatus {
  POLICY_ISSUED
  PLACEMENT_COMPLETED
}

enum RequestInvoiceStatus {
  DRAFT
  RFI_SUBMITTED
  RETURNED_TO_TECHNICAL
  READY_FOR_INVOICE
}

enum RequestInvoiceReviewAction {
  APPROVED
  RETURNED
}

enum RequestInvoiceDocumentType {
  POLICY_DOCUMENT
  SIGNED_QS
  CN_DN
  RENEWAL_ATTACHMENT
  OTHER
}

enum InvoiceDocumentType {
  INVOICE_PDF
  VOUCHER
}

enum InvoiceStatus {
  INVOICE_ISSUED
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum IncomingPaymentStatus {
  PAID
  REFUNDED
}

enum OutgoingPaymentStatus {
  WAITING_PAYMENT
  PARTIAL_PAYMENT
  FULLY_PAID
}

enum ShipmentStatus {
  SHIPPED
  DELIVERED
  COMPLETED
}

model OrganizationUnit {
  id       String  @id @default(cuid()) @map("_id")
  parentId String?

  name String
  type UnitType

  parent   OrganizationUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("UnitHierarchy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users       User[]
  permissions OrganizationUnitPermission[]
  quotations  Quotation[]

  @@unique([name, type])
  @@map("organization_unit")
}

model User {
  id       String   @id @default(cuid()) @map("_id")
  fullname String
  email    String   @unique
  phone    String?  @unique
  password String   @db.Text
  role     UserRole @default(USER)

  organizationUnitId   String?
  organizationUnit     OrganizationUnit?     @relation(fields: [organizationUnitId], references: [id])
  logs                 Log[]
  createdQuotations    Quotation[]           @relation("QuotationCreatedBy")
  approvedQuotations   Quotation[]           @relation("QuotationApprovedBy")
  quotationApprovals   QuotationApproval[]   @relation("QuotationApprovalActor")
  quotationHistories   QuotationHistory[]    @relation("QuotationHistoryActor")
  quotationSubmissions QuotationSubmission[] @relation("QuotationSubmissionSender")
  insuranceReviews     InsuranceReview[]     @relation("InsuranceReviewRecorder")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("user")
}

model Permission {
  id          String  @id @default(cuid()) @map("_id")
  resource    String
  action      String
  description String?

  organizations OrganizationUnitPermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([resource, action])
  @@map("permission")
}

model OrganizationUnitPermission {
  organizationUnitId String
  permissionId       String

  organizationUnit OrganizationUnit @relation(fields: [organizationUnitId], references: [id])
  permission       Permission       @relation(fields: [permissionId], references: [id])

  @@id([organizationUnitId, permissionId])
  @@map("organization_unit_permission")
}

model Log {
  id            String            @id @default(cuid()) @map("_id")
  userId        String
  action        LogAction
  description   String            @db.Text
  referenceId   String?
  referenceType LogReferenceType?
  details       String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([referenceType, referenceId])
  @@map("log")
}

model InsuranceType {
  id          String  @id @default(cuid()) @map("_id")
  code        String  @unique
  name        String
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotations Quotation[]
  policies   Policy[]

  @@index([deletedAt])
  @@map("insurance_type")
}

model InsuranceCompany {
  id            String  @id @default(cuid()) @map("_id")
  code          String  @unique
  name          String
  address       String?
  phone         String?
  email         String?
  contactPerson String?
  status        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  policyParticipants   PolicyParticipant[]
  quotationSubmissions QuotationSubmission[]

  @@index([deletedAt])
  @@map("insurance_company")
}

model Bank {
  id            String  @id @default(cuid()) @map("_id")
  name          String
  accountNumber String?
  accountName   String?
  branch        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  incomingPayments IncomingPayment[]

  @@index([deletedAt])
  @@map("bank")
}

model QsTemplate {
  id              String  @id @default(cuid()) @map("_id")
  name            String
  templateVersion String?
  templateDomain  QsTemplateDomain?
  pniClubFormat   PniClubFormat?
  content         Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([templateDomain])
  @@index([pniClubFormat])
  @@map("qs_template")
}

model Warranty {
  id          String  @id @default(cuid()) @map("_id")
  code        String?
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotationWarranties QuotationWarranty[]

  @@index([deletedAt])
  @@map("warranty")
}

model TermsCondition {
  id          String  @id @default(cuid()) @map("_id")
  code        String?
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotationTerms QuotationTerm[]

  @@index([deletedAt])
  @@map("terms_condition")
}

model Surveyor {
  id      String  @id @default(cuid()) @map("_id")
  name    String
  phone   String?
  email   String?
  address String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotationSurveyors QuotationSurveyor[]

  @@index([deletedAt])
  @@map("surveyor")
}

model Adjuster {
  id      String  @id @default(cuid()) @map("_id")
  name    String
  phone   String?
  email   String?
  address String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotationAdjusters QuotationAdjuster[]

  @@index([deletedAt])
  @@map("adjuster")
}

model Client {
  id            String  @id @default(cuid()) @map("_id")
  clientCode    String  @unique
  name          String
  address       String?
  phone         String?
  email         String?
  contactPerson String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotations Quotation[]

  @@index([deletedAt])
  @@map("client")
}

model Quotation {
  id              String  @id @default(cuid()) @map("_id")
  quotationNumber String  @unique
  clientId        String
  insuranceTypeId String
  technicalUnitId String?

  insured String?
  address String?
  recipient String?
  attentionTo String?

  quotationDate DateTime?

  periodStart DateTime?
  periodEnd   DateTime?
  periodText  String?

  interest            String?
  sumInsured          Decimal? @db.Decimal(15, 2)
  sumInsuredCurrency  String?
  rate                Decimal? @db.Decimal(15, 4)
  premium             Decimal? @db.Decimal(15, 2)
  deductible          Decimal? @db.Decimal(15, 2)
  deductibleText      String?
  deductibleBasis     String?
  brokerage           Decimal? @db.Decimal(15, 4)
  insuranceLabelValue String?
  confirmedAcceptedBy String?

  status QuotationStatus

  createdById  String?
  approvedById String?
  approvedAt   DateTime?

  insurerRevisionRequestedAt DateTime?
  insurerRevisionUpdatedAt   DateTime?

  templateVersion String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client        Client            @relation(fields: [clientId], references: [id])
  insuranceType InsuranceType     @relation(fields: [insuranceTypeId], references: [id])
  technicalUnit OrganizationUnit? @relation(fields: [technicalUnitId], references: [id])
  createdBy     User?             @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?             @relation("QuotationApprovedBy", fields: [approvedById], references: [id])

  objects     QuotationObject[]
  coverages   QuotationCoverage[]
  terms       QuotationTerm[]
  warranties  QuotationWarranty[]
  attachments QuotationAttachment[]
  approvals   QuotationApproval[]
  histories   QuotationHistory[]
  submissions QuotationSubmission[]
  policy      Policy?
  pniQuotation PniQuotation?
  hmQuotation HmQuotation?
  cargoQuotation CargoQuotation?
  adjusters   QuotationAdjuster[]
  surveyors   QuotationSurveyor[]

  @@index([clientId])
  @@index([insuranceTypeId])
  @@index([technicalUnitId])
  @@index([status])
  @@index([deletedAt])
  @@map("quotation")
}

model HmQuotation {
  id          String @id @default(cuid()) @map("_id")
  quotationId String @unique

  vesselType              String?
  tradingWarranty         String? @db.Text
  premiumPaymentEnabled   Boolean @default(true)
  brokerageEnabled        Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation   Quotation                @relation(fields: [quotationId], references: [id])
  installments HmQuotationInstallment[]

  @@index([deletedAt])
  @@map("hm_quotation")
}

model CargoQuotation {
  id          String @id @default(cuid()) @map("_id")
  quotationId String @unique

  interestInsured        String? @db.Text
  voyageFrom             String?
  voyageTo               String?
  etd                    DateTime?
  eta                    DateTime?
  conveyance             String?
  instituteCargoClause   CargoInstituteClause?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([deletedAt])
  @@map("cargo_quotation")
}

model HmQuotationInstallment {
  id            String @id @default(cuid()) @map("_id")
  hmQuotationId String
  installmentNo Int
  percentage    Decimal? @db.Decimal(5, 2)
  dueAfterDays  Int?
  amount        Decimal? @db.Decimal(15, 2)
  currency      String?
  dueDate       DateTime?
  sortOrder     Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hmQuotation HmQuotation @relation(fields: [hmQuotationId], references: [id])

  @@unique([hmQuotationId, installmentNo])
  @@index([deletedAt])
  @@map("hm_quotation_installment")
}

model QuotationAdjuster {
  quotationId String
  adjusterId  String
  sortOrder   Int @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  adjuster  Adjuster  @relation(fields: [adjusterId], references: [id])

  @@id([quotationId, adjusterId])
  @@index([adjusterId])
  @@map("quotation_adjuster")
}

model QuotationSurveyor {
  quotationId String
  surveyorId  String
  sortOrder   Int @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  surveyor  Surveyor  @relation(fields: [surveyorId], references: [id])

  @@id([quotationId, surveyorId])
  @@index([surveyorId])
  @@map("quotation_surveyor")
}

model PniQuotation {
  id          String        @id @default(cuid()) @map("_id")
  quotationId String        @unique
  clubFormat  PniClubFormat

  referenceNumber     String?
  validityDays        Int?
  assuredDomicile     String?
  broker              String?
  insurerOrSecurity   String? @db.Text
  tradingLimits       String? @db.Text
  paymentTermsText    String? @db.Text
  subjectivities      String? @db.Text
  importantInformation String? @db.Text
  signatureName       String?
  signatureCity       String?
  signatureDate       DateTime?
  details             Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation            Quotation               @relation(fields: [quotationId], references: [id])
  vessels              PniVessel[]
  insuranceBlocks      PniInsuranceBlock[]
  provisions           PniProvision[]
  installments         PniInstallment[]
  requiredDocuments    PniRequiredDocument[]
  organizationRoles    PniOrganizationRole[]
  coverRestrictions    PniCoverRestriction[]

  @@index([clubFormat])
  @@index([deletedAt])
  @@map("pni_quotation")
}

model PniVessel {
  id              String @id @default(cuid()) @map("_id")
  pniQuotationId  String
  name            String
  imoNumber       String?
  vesselType      String?
  builtYear       Int?
  flag            String?
  vesselClass     String?
  classNotApplicable Boolean @default(false)
  grossTonnage    Decimal? @db.Decimal(15, 2)
  portOfRegistry  String?
  sortOrder       Int     @default(0)
  details         Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pniQuotation        PniQuotation              @relation(fields: [pniQuotationId], references: [id])
  coverages           PniVesselCoverage[]
  provisionScopes     PniProvisionVessel[]
  deductibleScopes    PniDeductibleVessel[]

  @@index([pniQuotationId])
  @@index([deletedAt])
  @@map("pni_vessel")
}

model PniInsuranceBlock {
  id                  String          @id @default(cuid()) @map("_id")
  pniQuotationId      String
  inheritsFromBlockId String?
  typeOfInsurance     String
  security            String?         @db.Text
  policyWordingReference String?      @db.Text
  tradingArea          String?         @db.Text
  paymentWarrantyText  String?         @db.Text
  maximumInsured       Decimal?        @db.Decimal(15, 2)
  currency             String          @default("USD")
  premium              Decimal         @default(0) @db.Decimal(15, 2)
  premiumBasis         PniPremiumBasis @default(PER_ANNUM)
  sortOrder            Int             @default(0)
  details              Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pniQuotation PniQuotation       @relation(fields: [pniQuotationId], references: [id])
  inheritsFrom PniInsuranceBlock? @relation("PniInsuranceBlockInheritance", fields: [inheritsFromBlockId], references: [id])
  inheritedBy  PniInsuranceBlock[] @relation("PniInsuranceBlockInheritance")
  vesselCoverages PniVesselCoverage[]
  provisions      PniProvision[]
  deductibles     PniDeductible[]
  coverRestrictions PniCoverRestriction[]

  @@index([pniQuotationId])
  @@index([inheritsFromBlockId])
  @@index([deletedAt])
  @@map("pni_insurance_block")
}

model PniVesselCoverage {
  id                  String  @id @default(cuid()) @map("_id")
  pniVesselId         String
  insuranceBlockId    String
  annualPremium       Decimal? @db.Decimal(15, 2)
  limitAmount         Decimal? @db.Decimal(15, 2)
  currency            String  @default("USD")
  details             Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vessel         PniVessel         @relation(fields: [pniVesselId], references: [id])
  insuranceBlock PniInsuranceBlock @relation(fields: [insuranceBlockId], references: [id])

  @@unique([pniVesselId, insuranceBlockId])
  @@index([insuranceBlockId])
  @@index([deletedAt])
  @@map("pni_vessel_coverage")
}

model PniProvision {
  id                String             @id @default(cuid()) @map("_id")
  pniQuotationId    String
  insuranceBlockId  String?
  type              PniProvisionType
  source            PniProvisionSource @default(CUSTOM)
  scope             PniProvisionScope  @default(QUOTE)
  title             String
  content           String?            @db.Text
  reference         String?            @db.Text
  conditionRule     Json?
  sortOrder         Int                @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pniQuotation  PniQuotation       @relation(fields: [pniQuotationId], references: [id])
  insuranceBlock PniInsuranceBlock? @relation(fields: [insuranceBlockId], references: [id])
  vesselScopes  PniProvisionVessel[]

  @@index([pniQuotationId])
  @@index([insuranceBlockId])
  @@index([deletedAt])
  @@map("pni_provision")
}

model PniProvisionVessel {
  provisionId String
  vesselId    String

  provision PniProvision @relation(fields: [provisionId], references: [id])
  vessel    PniVessel    @relation(fields: [vesselId], references: [id])

  @@id([provisionId, vesselId])
  @@index([vesselId])
  @@map("pni_provision_vessel")
}

model PniDeductible {
  id                String             @id @default(cuid()) @map("_id")
  insuranceBlockId  String
  scope             PniDeductibleScope
  claimCategory     String?
  amount            Decimal?           @db.Decimal(15, 2)
  currency          String             @default("USD")
  description       String?            @db.Text
  sortOrder         Int                @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  insuranceBlock PniInsuranceBlock      @relation(fields: [insuranceBlockId], references: [id])
  vesselScopes   PniDeductibleVessel[]

  @@index([insuranceBlockId])
  @@index([deletedAt])
  @@map("pni_deductible")
}

model PniDeductibleVessel {
  deductibleId String
  vesselId     String

  deductible PniDeductible @relation(fields: [deductibleId], references: [id])
  vessel     PniVessel     @relation(fields: [vesselId], references: [id])

  @@id([deductibleId, vesselId])
  @@index([vesselId])
  @@map("pni_deductible_vessel")
}

model PniInstallment {
  id              String @id @default(cuid()) @map("_id")
  pniQuotationId  String
  installmentNo   Int
  amount          Decimal? @db.Decimal(15, 2)
  currency        String @default("USD")
  dueDate         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pniQuotation PniQuotation @relation(fields: [pniQuotationId], references: [id])

  @@unique([pniQuotationId, installmentNo])
  @@index([deletedAt])
  @@map("pni_installment")
}

model PniRequiredDocument {
  id              String @id @default(cuid()) @map("_id")
  pniQuotationId  String
  name            String
  isRequired      Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pniQuotation PniQuotation @relation(fields: [pniQuotationId], references: [id])

  @@index([pniQuotationId])
  @@index([deletedAt])
  @@map("pni_required_document")
}

model PniOrganizationRole {
  id              String @id @default(cuid()) @map("_id")
  pniQuotationId  String
  organization    String?
  role            String
  sortOrder       Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pniQuotation PniQuotation @relation(fields: [pniQuotationId], references: [id])

  @@index([pniQuotationId])
  @@index([deletedAt])
  @@map("pni_organization_role")
}

model PniCoverRestriction {
  id                String  @id @default(cuid()) @map("_id")
  pniQuotationId    String
  insuranceBlockId  String?
  name              String
  partReference     String?
  sectionReference  String?
  isSelected        Boolean @default(true)
  sortOrder         Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pniQuotation  PniQuotation        @relation(fields: [pniQuotationId], references: [id])
  insuranceBlock PniInsuranceBlock? @relation(fields: [insuranceBlockId], references: [id])

  @@index([pniQuotationId])
  @@index([insuranceBlockId])
  @@index([deletedAt])
  @@map("pni_cover_restriction")
}

model QuotationObject {
  id          String @id @default(cuid()) @map("_id")
  quotationId String
  objectType  String
  data        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
  @@index([deletedAt])
  @@map("quotation_object")
}

model QuotationCoverage {
  id           String   @id @default(cuid()) @map("_id")
  quotationId  String
  coverageType String?
  description  String?
  value        Decimal? @db.Decimal(15, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
  @@index([deletedAt])
  @@map("quotation_coverage")
}

model QuotationTerm {
  id               String  @id @default(cuid()) @map("_id")
  quotationId      String
  termsConditionId String?
  description      String? @db.Text
  section          QuotationTermSection @default(TERMS_CONDITIONS)
  sortOrder        Int                  @default(0)
  isSelected       Boolean              @default(true)
  isEditable       Boolean              @default(false)
  isRemovable      Boolean              @default(false)
  selectionGroup   String?
  conditionRule    Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation      Quotation       @relation(fields: [quotationId], references: [id])
  termsCondition TermsCondition? @relation(fields: [termsConditionId], references: [id])

  @@index([quotationId])
  @@index([termsConditionId])
  @@index([deletedAt])
  @@map("quotation_term")
}

model QuotationWarranty {
  id          String  @id @default(cuid()) @map("_id")
  quotationId String
  warrantyId  String?
  description String? @db.Text
  sortOrder   Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id])
  warranty  Warranty? @relation(fields: [warrantyId], references: [id])

  @@index([quotationId])
  @@index([warrantyId])
  @@index([deletedAt])
  @@map("quotation_warranty")
}

model QuotationAttachment {
  id          String  @id @default(cuid()) @map("_id")
  quotationId String
  fileName    String?
  url         String?
  mimeType    String?
  fileSize    Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
  @@index([deletedAt])
  @@map("quotation_attachment")
}

model QuotationApproval {
  id          String                  @id @default(cuid()) @map("_id")
  quotationId String
  approverId  String?
  action      QuotationApprovalAction
  note        String?                 @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id])
  approver  User?     @relation("QuotationApprovalActor", fields: [approverId], references: [id])

  @@index([quotationId])
  @@map("quotation_approval")
}

model QuotationHistory {
  id          String           @id @default(cuid()) @map("_id")
  quotationId String
  fromStatus  QuotationStatus?
  toStatus    QuotationStatus
  action      String?
  actorId     String?
  note        String?          @db.Text

  createdAt DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])
  actor     User?     @relation("QuotationHistoryActor", fields: [actorId], references: [id])

  @@index([quotationId])
  @@map("quotation_history")
}

model QuotationSubmission {
  id                 String   @id @default(cuid()) @map("_id")
  quotationId        String
  insuranceCompanyId String
  sentById           String
  note               String?  @db.Text
  snapshot           Json
  sentAt             DateTime @default(now())

  quotation        Quotation         @relation(fields: [quotationId], references: [id])
  insuranceCompany InsuranceCompany  @relation(fields: [insuranceCompanyId], references: [id])
  sentBy           User              @relation("QuotationSubmissionSender", fields: [sentById], references: [id])
  reviews          InsuranceReview[]

  @@index([quotationId])
  @@index([insuranceCompanyId])
  @@map("quotation_submission")
}

model InsuranceReview {
  id                    String                @id @default(cuid()) @map("_id")
  quotationSubmissionId String
  action                InsuranceReviewAction
  note                  String?               @db.Text
  recordedById          String
  reviewedAt            DateTime              @default(now())

  quotationSubmission QuotationSubmission @relation(fields: [quotationSubmissionId], references: [id])
  recordedBy          User                @relation("InsuranceReviewRecorder", fields: [recordedById], references: [id])

  @@index([quotationSubmissionId])
  @@map("insurance_review")
}

model Policy {
  id                String       @id @default(cuid()) @map("_id")
  quotationId       String       @unique
  policyNumber      String       @unique
  policyDate        DateTime?
  insuranceTypeId   String
  policyDocumentUrl String?
  status            PolicyStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation     Quotation     @relation(fields: [quotationId], references: [id])
  insuranceType InsuranceType @relation(fields: [insuranceTypeId], references: [id])

  participants    PolicyParticipant[]
  histories       PolicyHistory[]
  requestInvoices RequestInvoice[]

  @@index([quotationId])
  @@index([insuranceTypeId])
  @@index([status])
  @@index([deletedAt])
  @@map("policy")
}

model PolicyParticipant {
  id                 String          @id @default(cuid()) @map("_id")
  policyId           String
  insuranceCompanyId String
  role               ParticipantRole
  share              Decimal         @db.Decimal(5, 2)
  orderNo            Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  policy           Policy           @relation(fields: [policyId], references: [id])
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])

  outgoingPayments OutgoingPayment[]

  @@index([policyId])
  @@index([insuranceCompanyId])
  @@index([deletedAt])
  @@map("policy_participant")
}

model PolicyHistory {
  id         String        @id @default(cuid()) @map("_id")
  policyId   String
  fromStatus PolicyStatus?
  toStatus   PolicyStatus
  action     String?
  actorId    String?
  note       String?       @db.Text

  createdAt DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id])

  @@index([policyId])
  @@map("policy_history")
}

model RequestInvoice {
  id            String               @id @default(cuid()) @map("_id")
  requestNumber String               @unique
  policyId      String
  status        RequestInvoiceStatus
  notes         String?              @db.Text
  submittedById String?
  submittedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  policy Policy @relation(fields: [policyId], references: [id])

  documents RequestInvoiceDocument[]
  reviews   RequestInvoiceReview[]
  invoices  Invoice[]

  @@index([policyId])
  @@index([status])
  @@index([deletedAt])
  @@map("request_invoice")
}

model RequestInvoiceDocument {
  id               String                     @id @default(cuid()) @map("_id")
  requestInvoiceId String
  documentType     RequestInvoiceDocumentType
  fileName         String?
  url              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  requestInvoice RequestInvoice @relation(fields: [requestInvoiceId], references: [id])

  @@index([requestInvoiceId])
  @@index([deletedAt])
  @@map("request_invoice_document")
}

model RequestInvoiceReview {
  id               String                     @id @default(cuid()) @map("_id")
  requestInvoiceId String
  reviewerId       String?
  action           RequestInvoiceReviewAction
  notes            String?                    @db.Text

  createdAt DateTime @default(now())

  requestInvoice RequestInvoice @relation(fields: [requestInvoiceId], references: [id])

  @@index([requestInvoiceId])
  @@map("request_invoice_review")
}

model Invoice {
  id               String        @id @default(cuid()) @map("_id")
  requestInvoiceId String
  invoiceNumber    String        @unique
  issueDate        DateTime?
  dueDate          DateTime?
  subtotal         Decimal?      @db.Decimal(15, 2)
  ppn              Decimal?      @db.Decimal(15, 2)
  grandTotal       Decimal?      @db.Decimal(15, 2)
  status           InvoiceStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  requestInvoice RequestInvoice @relation(fields: [requestInvoiceId], references: [id])

  documents        InvoiceDocument[]
  incomingPayments IncomingPayment[]
  shipments        Shipment[]

  @@index([requestInvoiceId])
  @@index([status])
  @@index([deletedAt])
  @@map("invoice")
}

model InvoiceDocument {
  id           String              @id @default(cuid()) @map("_id")
  invoiceId    String
  documentType InvoiceDocumentType
  fileName     String?
  url          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([deletedAt])
  @@map("invoice_document")
}

model IncomingPayment {
  id                String                @id @default(cuid()) @map("_id")
  invoiceId         String
  paymentDate       DateTime?
  amount            Decimal?              @db.Decimal(15, 2)
  paymentMethod     String?
  bankId            String?
  receiptNumber     String?
  proofOfPaymentUrl String?
  status            IncomingPaymentStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  bank    Bank?   @relation(fields: [bankId], references: [id])

  installments IncomingPaymentInstallment[]

  @@index([invoiceId])
  @@index([bankId])
  @@index([deletedAt])
  @@map("incoming_payment")
}

model IncomingPaymentInstallment {
  id                String    @id @default(cuid()) @map("_id")
  incomingPaymentId String
  installmentOrder  Int?
  amount            Decimal?  @db.Decimal(15, 2)
  dueDate           DateTime?
  paymentDate       DateTime?
  proofOfPaymentUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  incomingPayment IncomingPayment @relation(fields: [incomingPaymentId], references: [id])

  @@index([incomingPaymentId])
  @@index([deletedAt])
  @@map("incoming_payment_installment")
}

model OutgoingPayment {
  id                  String                @id @default(cuid()) @map("_id")
  policyParticipantId String
  amount              Decimal?              @db.Decimal(15, 2)
  paymentDate         DateTime?
  status              OutgoingPaymentStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  policyParticipant PolicyParticipant @relation(fields: [policyParticipantId], references: [id])

  installments OutgoingInstallment[]

  @@index([policyParticipantId])
  @@index([status])
  @@index([deletedAt])
  @@map("outgoing_payment")
}

model OutgoingInstallment {
  id                String    @id @default(cuid()) @map("_id")
  outgoingPaymentId String
  installmentOrder  Int?
  amount            Decimal?  @db.Decimal(15, 2)
  paymentDate       DateTime?
  proofOfPaymentUrl String?
  notes             String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  outgoingPayment OutgoingPayment @relation(fields: [outgoingPaymentId], references: [id])

  @@index([outgoingPaymentId])
  @@index([deletedAt])
  @@map("outgoing_installment")
}

model Shipment {
  id             String         @id @default(cuid()) @map("_id")
  invoiceId      String
  courier        String?
  trackingNumber String?
  shipmentDate   DateTime?
  receiver       String?
  status         ShipmentStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  documents ShipmentDocument[]

  @@index([invoiceId])
  @@index([status])
  @@index([deletedAt])
  @@map("shipment")
}

model ShipmentDocument {
  id           String  @id @default(cuid()) @map("_id")
  shipmentId   String
  documentType String?
  fileName     String?
  url          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@index([deletedAt])
  @@map("shipment_document")
}

model Notification {
  id          String  @id @default(cuid()) @map("_id")
  recipientId String
  title       String?
  message     String? @db.Text
  isRead      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId])
  @@map("notification")
}

model FileUpload {
  id           String  @id @default(cuid()) @map("_id")
  module       String?
  referenceId  String?
  fileName     String?
  url          String?
  uploadedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([module, referenceId])
  @@index([deletedAt])
  @@map("file_upload")
}
