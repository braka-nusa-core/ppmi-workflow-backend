generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UnitType {
  DIVISION
  DEPARTMENT
}

enum UserRole {
  SUPERADMIN
  USER
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  REVISION
  CANCEL
  LOGIN
  LOGOUT
  VIEW
  CLICK
  OTHER
}

enum LogReferenceType {
  QUOTATION_SLIP
  POLICY_PLACEMENT
  REQUEST_FOR_INVOICE
  INVOICE
  INCOMING_PAYMENT
  OUTGOING_PAYMENT
  SHIPMENT
  USER_MANAGEMENT
  INSURANCE_COMPANY
  SURVEYOR
  WARRANTY
  TERMS_AND_CONDITIONS
  QS_TEMPLATE
  BANK
  INSURANCE_TYPE
}

model OrganizationUnit {
  id            String   @id @default(cuid()) @map("_id")
  parentId      String?

  name          String
  type          UnitType

  parent        OrganizationUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id])
  children      OrganizationUnit[] @relation("UnitHierarchy")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  users         User[]
  permissions   OrganizationUnitPermission[]

  @@unique([name, type])
  @@map("organization_unit")
}

model User {
  id                    String    @id @default(cuid()) @map("_id")
  fullname              String
  email                 String    @unique
  phone                 String?   @unique
  password              String    @db.Text
  role                  UserRole  @default(USER)

  organizationUnitId    String?
  organizationUnit      OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  logs                  Log[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@map("user")
}

model Permission {
  id                    String    @id @default(cuid()) @map("_id")
  resource              String
  action                String
  description           String?

  organizations         OrganizationUnitPermission[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@unique([resource, action])
  @@map("permission")
}

model OrganizationUnitPermission {
  organizationUnitId    String
  permissionId          String

  organizationUnit      OrganizationUnit  @relation(fields: [organizationUnitId], references: [id])
  permission            Permission        @relation(fields: [permissionId], references: [id])

  @@id([organizationUnitId, permissionId])
  @@map("organization_unit_permission")
}

model Log {
  id              String         @id @default(uuid()) @map("_id")
  userId          String
  action          LogAction
  description     String         @db.Text
  referenceId     String?
  referenceType   LogReferenceType?
  details         String?        @db.Text

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id])

  @@index([referenceType, referenceId])
  @@map("log")
}
